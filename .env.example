# .env - Configuration File for Deployment
# Copy this file to .env and update values before deployment

# Backend Configuration
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# For SQLite (default): sqlite:///./parkinsons.db
# For PostgreSQL: postgresql://user:password@localhost/parkinsons_db
DATABASE_URL=sqlite:///./parkinsons.db

# Frontend Configuration (Streamlit)
BACKEND_URL = https://parkinson-detection-9xui.onrender.com

# Model Configuration
MODEL_PATH=model/parkinsons_detector.keras

# CORS Configuration (for production, restrict origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
